DATABASE_URL= 
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Cortex <noreply@devcortex.io>"
APP_URL=http://localhost:3000

# "false" skips email verification. Unset or anything else = on.
EMAIL_VERIFICATION_ENABLED=true

# Upstash Redis for auth rate limiting. Unset = no limiting (fails open).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Bictorys payments: the API base URL (sandbox or live) and the public API key.
BICTORYS_API_URL=""
BICTORYS_API_KEY=""
BICTORYS_WEBHOOK_SECRET=""

# AI features. AI_PROVIDER: openrouter (default) or openai. AI_MODEL empty = the provider's
# default (nvidia/nemotron-3-ultra-550b-a55b:free on openrouter, gpt-6-luna on openai).
# Do not set AI_PROVIDER=openai before the OpenAI account is set up and has credits.
AI_PROVIDER=""
AI_MODEL=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
