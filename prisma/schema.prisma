// Prisma 7: the datasource URL lives in prisma.config.ts, not here.
// The generator is `prisma-client` (not `prisma-client-js`) and needs an
// explicit output; importFileExtension = "" keeps the generated imports
// compatible with the Next.js bundler.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v5 / @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  // Null for OAuth-only users.
  password          String?
  // Sessions signed in before this are ended by the `jwt` callback.
  passwordChangedAt DateTime?
  // Monaco settings from /settings; null or missing keys fall back to the defaults.
  editorPreferences Json?
  // "en" | "fr", set from /settings. Null: follow the cookie, then the browser.
  locale            String?

  // Mirror of `proUntil`, a readable flag only: every gate reads `isProActive(proUntil)`.
  isPro    Boolean   @default(false)
  // Pro is active while this is in the future. Null: never paid.
  proUntil DateTime?

  accounts    Account[]
  sessions    Session[]
  items       Item[]
  itemTypes   ItemType[]
  collections Collection[]
  tags        Tag[]
  payments    Payment[]
  apiTokens   ApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The adapter queries `where: { provider_providerAccountId }`.
  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  // Deliberately no `id`: the adapter strips any id field it finds.
  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model ItemType {
  id       String  @id @default(cuid())
  // "snippet" | "prompt" | "note" | "command" | "file" | "image" | "link".
  // Kept as a string rather than an enum because Pro users add custom types.
  slug     String
  name     String
  // A key of `CUSTOM_TYPE_ICONS` for a custom type; unknown keys render as Box.
  icon     String?
  color    String?
  isSystem Boolean @default(false)
  // Custom types only: Markdown that pre-fills a new item's content (at most 10,000 characters).
  template String?

  // Null for the built-in types, set for a Pro user's custom ones.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Links, not items: an item can sit in several collections.
  items ItemCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, isFavorite])
}

model Item {
  id          String  @id @default(cuid())
  title       String
  description String?
  // "text" | "file".
  contentType String  @default("text")
  content     String?
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  url         String?
  isFavorite  Boolean @default(false)
  isPinned    Boolean @default(false)
  language    String?
  /// Last copy, download or opening in the drawer (A5). Written with raw SQL, throttled to
  /// once per 5 minutes, so `updatedAt` never moves for a use.
  lastUsedAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade: deleting a type that items still use should fail
  // rather than silently delete their items.
  typeId String
  type   ItemType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  // Zero, one or several. Deleting a collection drops only its links, so the items stay.
  collections ItemCollection[]

  tags ItemTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([typeId])
  @@index([userId, updatedAt])
  @@index([userId, isPinned])
  @@index([userId, isFavorite])
  @@index([userId, lastUsedAt])
}

model Tag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemTag[]

  createdAt DateTime @default(now())

  // A user cannot create the same tag twice.
  @@unique([userId, name])
  @@index([userId])
}

model ItemCollection {
  itemId       String
  collectionId String
  addedAt      DateTime @default(now())

  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([itemId, collectionId])
  @@index([collectionId])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Billing (Bictorys one-off charges that extend `User.proUntil`)
// ---------------------------------------------------------------------------

enum BillingPlan {
  MONTHLY
  YEARLY
}

enum Currency {
  USD
  EUR
  XOF
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  // Paid at Bictorys, but the amount or currency did not match; fixed by hand.
  NEEDS_REVIEW
}

/// One Bictorys checkout. `reference` is the `paymentReference` sent to Bictorys,
/// so every webhook maps to exactly one row.
model Payment {
  id        String @id @default(cuid())
  reference String @unique

  // SetNull, not Cascade: payments are kept when the account is deleted.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  plan BillingPlan
  // Major units, as sent to Bictorys.
  amount        Int
  currency      Currency
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// Personal API token (C1) for the REST API, the MCP server and the CLI.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // First 12 characters of the token ("cstash_" + 5), shown in the list to tell tokens apart.
  prefix     String
  // SHA-256 of the whole token, hex. The token itself is never stored.
  hash       String    @unique
  // "read" or "write" (write implies read).
  scope      String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
